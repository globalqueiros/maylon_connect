# Copy to .env on the deploy server (or .env.local for local overrides).
# Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_URL=https://your-domain.example

# MySQL primary (users, trips, beneficios, sessions)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=smartmobility_db

# MySQL secondary (if used)
DB2_HOST=
DB2_USER=
DB2_PASSWORD=
DB2_NAME=maylon_db

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portal Connect - Maylon <no-reply@maylon.com.br>"
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Portal Connect - Maylon <no-reply@maylon.com.br>"

# AWS (optional uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# BTG Pactual / PIX  (required for real "Gerar QR de Autorização")
# Set BTG_MOCK=true only for local UI demo without banking keys.
BTG_MOCK=false
BTG_ENV=production
BTG_CLIENT_ID=
BTG_CLIENT_SECRET=
BTG_SECRET=
BTG_COMPANY_ID=
BTG_ACCOUNT_NUMBER=
BTG_ACCOUNT_BRANCH=1
BTG_PIX_KEY=
BTG_ACCESS_TOKEN=
BTG_REFRESH_TOKEN=
BTG_WEBHOOK_SECRET=
BTG_SCOPE=brn:btg:empresas:banking:collections openid empresas.btgpactual.com/pix-cash-in

# Cookie (set true only behind real HTTPS)
COOKIE_SECURE=false

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
